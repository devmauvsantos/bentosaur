; Engine configuration file.
; Edit in Godot where possible; this proof keeps the file intentionally small.

config_version=5

[application]

config/name="Bentosaur"
run/main_scene="res://scenes/labs/facial_animation_options_lab.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.047, 0.063, 1)
