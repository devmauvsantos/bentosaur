{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bentosaur.local/schemas/character-gate-decision-v1.json",
  "title": "Bentosaur Character Gate Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gate_id",
    "character_id",
    "evaluates",
    "scope",
    "technical",
    "human",
    "authorizes",
    "does_not_authorize"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "gate_id": {
      "type": "string",
      "pattern": "^G[0-9]{2}_[A-Z0-9_]+$"
    },
    "character_id": {
      "type": "string"
    },
    "evaluates": {
      "type": "object",
      "required": [
        "stage_manifest",
        "stage_manifest_sha256"
      ],
      "properties": {
        "stage_manifest": {
          "type": "string"
        },
        "stage_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "scope": {
      "type": "string"
    },
    "technical": {
      "type": "object",
      "required": [
        "state",
        "evidence"
      ],
      "properties": {
        "state": {
          "enum": [
            "pass",
            "fail",
            "pending"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "human": {
      "type": "object",
      "required": [
        "required",
        "owner",
        "state",
        "decided_at",
        "notes"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "owner": {
          "type": "string"
        },
        "state": {
          "enum": [
            "approved",
            "rejected",
            "pending",
            "not_required"
          ]
        },
        "decided_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "authorizes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "does_not_authorize": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
